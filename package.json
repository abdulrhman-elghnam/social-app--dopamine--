{
  "name": "dopamine",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "./dist/main.js",
  "scripts": {
    "start:dev": "concurrently -k \"tsc --watch\" \"node --watch ./dist/main.js\"",
    "start:prod-local": "cross-env NODE_ENV=prod node --watch ./src/main.js",
    "start:prod": "cross-env NODE_ENV=prod pm2 start ./src/main.js -i max",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:config": "oxlint --init",
    "format": "npx prettier . --write"
  },
  "dependencies": {
    "concurrently": "^10.0.6",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "globals": "^17.13.0",
    "oxlint": "^1.89.0",
    "prettier": "3.9.10"
  }
}
