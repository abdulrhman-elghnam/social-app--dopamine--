@Host = http://127.0.0.1:9090
@AcceptLanguage = en

### Sign up
POST {{Host}}/authentication/signup
Content-Type: application/json
Accept-Language: {{AcceptLanguage}}

{
  "email": "user@example.com",
  "username": "test_user",
  "password": "Password1!",
  "confirmPassword": "Password1!",
  "fullName": "Test User",
  "gender": "MALE",
  "phoneNumber": "+201012345678",
  "DOB": "2000-01-01"
}

### Verify email OTP
POST {{Host}}/authentication/verify-otp
Content-Type: application/json
Accept-Language: {{AcceptLanguage}}

{
  "email": "user@example.com",
  "otp": "123456"
}

### Login
POST {{Host}}/authentication/login
Content-Type: application/json
Accept-Language: {{AcceptLanguage}}

{
  "email": "user@example.com",
  "password": "Password1!"
}

### Google sign in
POST {{Host}}/authentication/google-signup
Content-Type: application/json
Accept-Language: {{AcceptLanguage}}

{
  "idToken": "replace-with-google-id-token"
}

### Request password reset OTP
POST {{Host}}/authentication/forgot-password
Content-Type: application/json
Accept-Language: {{AcceptLanguage}}

{
  "email": "user@example.com"
}

### Verify password reset OTP
POST {{Host}}/authentication/verify-forgot-password
Content-Type: application/json
Accept-Language: {{AcceptLanguage}}

{
  "email": "user@example.com",
  "otp": "123456"
}

### Change password
POST {{Host}}/authentication/change-password
Content-Type: application/json
Accept-Language: {{AcceptLanguage}}

{
  "email": "user@example.com",
  "password": "NewPassword1!",
  "confirmPassword": "NewPassword1!"
}